generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Cabang / Site perusahaan
model Branch {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(100)
  code            String           @unique @db.VarChar(10)
  address         String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  assets          Asset[]
  ongoingPayments OngoingPayment[]
  recurringBills  RecurringBill[]
  transactions    Transaction[]
  users           User[]

  @@map("branches")
}

/// Pengguna sistem
model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique @db.VarChar(50)
  passwordHash    String           @map("password_hash") @db.VarChar(255)
  fullName        String           @map("full_name") @db.VarChar(100)
  role            UserRole         @default(DATA_ENTRY)
  branchId        Int?             @map("branch_id")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  assets          Asset[]
  auditLogs       AuditLog[]
  ongoingPayments OngoingPayment[]
  recurringBills  RecurringBill[]
  transactions    Transaction[]
  branch          Branch?          @relation(fields: [branchId], references: [id])

  @@map("users")
}

/// Kategori pengeluaran (e.g., Makanan & Minuman, Utilitas, ATK)
model Category {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(100)
  code            String           @unique @db.VarChar(20)
  icon            String?          @db.VarChar(50)
  isSystem        Boolean          @default(false) @map("is_system")
  fieldsConfig    Json?            @map("fields_config")
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  ongoingPayments OngoingPayment[]
  recurringBills  RecurringBill[]
  subCategories   SubCategory[]
  transactions    Transaction[]

  @@map("categories")
}

/// Sub-kategori (e.g., Susu, Listrik, Kertas)
model SubCategory {
  id              Int              @id @default(autoincrement())
  categoryId      Int              @map("category_id")
  name            String           @db.VarChar(100)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  ongoingPayments OngoingPayment[]
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions    Transaction[]

  @@map("sub_categories")
}

/// Transaksi pengeluaran GA
model Transaction {
  id              Int             @id @default(autoincrement())
  branchId        Int             @map("branch_id")
  userId          Int             @map("user_id")
  categoryId      Int             @map("category_id")
  subCategoryId   Int?            @map("sub_category_id")
  transactionDate DateTime        @map("transaction_date") @db.Date
  description     String          @db.VarChar(255)
  quantity        Decimal         @db.Decimal(10, 2)
  unit            String          @db.VarChar(20)
  pricePerUnit    Decimal         @map("price_per_unit") @db.Decimal(15, 2)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(15, 2)
  paymentMethod   PaymentMethod   @map("payment_method")
  vendor          String?         @db.VarChar(100)
  receiptPath     String?         @map("receipt_path") @db.VarChar(500)
  notes           String?
  customFields    Json?           @map("custom_fields")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  beritaAcara     String?         @unique @map("berita_acara") @db.VarChar(50)
  discountPerUnit Decimal?        @map("discount_per_unit") @db.Decimal(15, 2)
  discountTotal   Decimal?        @map("discount_total") @db.Decimal(15, 2)
  location        Location?
  taxAmount       Decimal?        @map("tax_amount") @db.Decimal(15, 2)
  taxNote         String?         @map("tax_note") @db.VarChar(50)
  invoiceNumber   String?         @map("invoice_number") @db.VarChar(100)
  ongoingPayment  OngoingPayment?
  branch          Branch          @relation(fields: [branchId], references: [id])
  category        Category        @relation(fields: [categoryId], references: [id])
  subCategory     SubCategory?    @relation(fields: [subCategoryId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@index([branchId, transactionDate(sort: Desc)], map: "idx_tx_branch_date")
  @@index([categoryId], map: "idx_tx_category")
  @@index([userId], map: "idx_tx_user")
  @@index([transactionDate(sort: Desc)], map: "idx_tx_date")
  @@index([paymentMethod], map: "idx_tx_payment")
  @@index([location])
  @@map("transactions")
}

/// Ongoing Payments (Pembayaran Berjalan)
model OngoingPayment {
  id                 Int            @id @default(autoincrement())
  branchId           Int            @map("branch_id")
  categoryId         Int            @map("category_id")
  subCategoryId      Int?           @map("sub_category_id")
  userId             Int            @map("user_id")
  description        String         @db.VarChar(255)
  amountNeeded       Decimal        @map("amount_needed") @db.Decimal(15, 2)
  initialReceiptPath String?        @map("initial_receipt_path") @db.VarChar(500)
  finalReceiptPath   String?        @map("final_receipt_path") @db.VarChar(500)
  status             String         @default("BELUM_DIBAYAR") @db.VarChar(20)
  isMoneyEnough      Boolean?       @map("is_money_enough")
  actualAmount       Decimal?       @map("actual_amount") @db.Decimal(15, 2)
  transactionId      Int?           @unique @map("transaction_id")
  frequency          String?        @db.VarChar(20)
  location           Location?
  recurringBillId    Int?           @map("recurring_bill_id")
  requestDate        DateTime       @default(now()) @map("request_date") @db.Date
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  notes              String?
  vendor             String?        @db.VarChar(100)
  quantity           Decimal?       @db.Decimal(10, 2)
  unit               String?        @db.VarChar(20)
  branch             Branch         @relation(fields: [branchId], references: [id])
  category           Category       @relation(fields: [categoryId], references: [id])
  recurringBill      RecurringBill? @relation(fields: [recurringBillId], references: [id])
  subCategory        SubCategory?   @relation(fields: [subCategoryId], references: [id])
  transaction        Transaction?   @relation(fields: [transactionId], references: [id])
  user               User           @relation(fields: [userId], references: [id])

  @@index([branchId, status])
  @@index([createdAt(sort: Desc)])
  @@index([recurringBillId], map: "idx_op_recurring_bill")
  @@index([subCategoryId], map: "idx_op_sub_category")
  @@index([location])
  @@map("ongoing_payments")
}

/// Template tagihan berulang — spawns OngoingPayment setiap siklus
model RecurringBill {
  id              Int                    @id @default(autoincrement())
  branchId        Int                    @map("branch_id")
  categoryId      Int                    @map("category_id")
  userId          Int                    @map("user_id")
  description     String                 @db.VarChar(255)
  /// Null = variable-amount bill (user enters actual at payment time)
  amountExpected  Decimal?               @map("amount_expected") @db.Decimal(15, 2)
  frequency       RecurringBillFrequency
  nextDueDate     DateTime               @map("next_due_date") @db.Date
  isActive        Boolean                @default(true) @map("is_active")
  location        Location?
  notes           String?
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  ongoingPayments OngoingPayment[]
  branch          Branch                 @relation(fields: [branchId], references: [id])
  category        Category               @relation(fields: [categoryId], references: [id])
  user            User                   @relation(fields: [userId], references: [id])

  @@index([branchId, nextDueDate], map: "idx_rb_branch_due")
  @@index([isActive, nextDueDate], map: "idx_rb_active_due")
  @@index([location])
  @@map("recurring_bills")
}

/// Catatan log audit aktivitas transaksi dan konfigurasi admin
model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  actionType  String   @map("action_type") @db.VarChar(20)
  targetTable String   @map("target_table") @db.VarChar(50)
  targetId    String   @map("target_id") @db.VarChar(50)
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id])

  @@index([createdAt(sort: Desc)], map: "idx_audit_created_at")
  @@index([userId], map: "idx_audit_user")
  @@map("audit_logs")
}

/// Aset / Inventaris Perusahaan (e.g. Laptop, Meja, Kendaraan)
model Asset {
  id             Int         @id @default(autoincrement())
  branchId       Int         @map("branch_id")
  userId         Int         @map("user_id")
  assetTag       String?     @unique @map("asset_tag") @db.VarChar(50)
  name           String      @db.VarChar(100)
  brandModel     String?     @map("brand_model") @db.VarChar(100)
  category       String      @db.VarChar(100)
  locationDetail String?     @map("location_detail") @db.VarChar(255)
  pic            String?     @db.VarChar(100)
  status         AssetStatus @default(AKTIF)
  imagePath      String?     @map("image_path") @db.VarChar(500)
  notes          String?
  archivedAt     DateTime?   @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  purchaseYear   Int?        @map("purchase_year")
  branch         Branch      @relation(fields: [branchId], references: [id])
  user           User        @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([category])
  @@index([status])
  @@index([archivedAt])
  @@map("assets")
}

enum UserRole {
  SUPERADMIN
  DATA_ENTRY
  VIEWER
  ADMIN
}

enum PaymentMethod {
  CASH
  TRANSFER
  PETTY_CASH
}

/// Frekuensi tagihan berulang
enum RecurringBillFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum Location {
  SITE
  MESS
  OFFICE
}

enum AssetStatus {
  AKTIF
  RUSAK
  DIPERBAIKI
  HILANG
}
